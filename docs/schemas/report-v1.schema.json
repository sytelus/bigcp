{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sytelus/bigcp/docs/schemas/report-v1.schema.json",
  "title": "bigcp run report v1",
  "type": "object",
  "required": [
    "v",
    "run",
    "config",
    "devices",
    "counters",
    "replacements",
    "errors",
    "warnings",
    "extras",
    "folders",
    "timeline",
    "phases",
    "bottleneck",
    "hints",
    "integrity"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "started",
        "ended",
        "duration_seconds",
        "exit",
        "dry_run",
        "durability",
        "audit",
        "source",
        "destination",
        "log_path",
        "report_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started": {
          "type": "string"
        },
        "ended": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "exit": {
          "type": "integer"
        },
        "dry_run": {
          "type": "boolean"
        },
        "durability": {
          "enum": [
            "logical",
            "durable"
          ]
        },
        "audit": {
          "enum": [
            "ok",
            "degraded",
            "failed"
          ]
        },
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "source_filesystem": {
          "type": "string",
          "description": "Filesystem family probed for the source root."
        },
        "destination_filesystem": {
          "type": "string",
          "description": "Filesystem family whose representation policy governed the destination."
        },
        "log_path": {
          "type": "string"
        },
        "report_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object"
    },
    "devices": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "endpoint": {
              "enum": [
                "local",
                "unc",
                "wsl"
              ]
            }
          },
          "additionalProperties": true
        },
        "destination": {
          "type": "object",
          "properties": {
            "endpoint": {
              "enum": [
                "local",
                "unc",
                "wsl"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "counters": {
      "type": "object"
    },
    "replacements": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    },
    "warnings": {
      "type": "object"
    },
    "extras": {
      "type": "object"
    },
    "folders": {
      "type": "object"
    },
    "timeline": {
      "type": "array",
      "maxItems": 3600
    },
    "phases": {
      "type": "object"
    },
    "bottleneck": {
      "type": "object"
    },
    "hints": {
      "type": "array"
    },
    "verify": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mode": {
          "enum": [
            "copied",
            "full"
          ]
        },
        "destination_filesystem": {
          "type": "string"
        },
        "projected": {
          "type": "boolean",
          "description": "True when verification used FAT-family, WSL, or unknown-remote projected semantics."
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "array"
        },
        "last_access_differences": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "integrity": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "analysis": {
      "type": "object",
      "description": "Bounded --analyze insight; present only when the flag was set.",
      "required": [
        "size_classes",
        "slowest_files"
      ],
      "properties": {
        "size_classes": {
          "type": "array"
        },
        "slowest_files": {
          "type": "array",
          "maxItems": 20
        }
      }
    }
  },
  "additionalProperties": true
}
